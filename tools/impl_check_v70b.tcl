# -----------------------------------------------------------------------------
#  impl_check_v70.tcl -- v70 REAL TURNTABLE (2048 PPR) PRODUCTION build
#
#  Source: _synth_work_v70/rtl_v70 (generated by tools/make_v70_rtl.py)
#    POLE_BITS stays 11 (2048 electrical cycles/rev),
#    RTL_BUILD_ID 0x000E -> 0x0011, INTER0 2 -> 32, GAIN_S/C 32768 (1.0)
#
#  Flow identical to v66/v67/v68 production so the numbers stay comparable:
#    synth_design -> opt -> place ExtraTimingOpt -> phys_opt AggressiveExplore
#    -> route Explore
#
#  Run:
#    powershell -NoProfile -ExecutionPolicy Bypass -File _flash2_work\run_vivado_hw.ps1 `
#        -Tcl tools/impl_check_v70.tcl -LogFile build_v70.log -Tail 60
#
#  NOTE: keep this file ASCII-only (Vivado reads .tcl via the system code page).
# -----------------------------------------------------------------------------
set ROOT   "C:/Users/zhaoy/Desktop/FPGA"
set OUTDIR "$ROOT/_impl_v70b"
file mkdir $OUTDIR

set RTLDIR "$ROOT/_synth_work_v70/rtl_v70"
set src_rtl [lsort [glob -nocomplain "$RTLDIR/*.v"]]
set src_eth [lsort [glob -nocomplain "$RTLDIR/eth/*.v"]]
set src $src_rtl
foreach f $src_eth { lappend src $f }

puts "INFO: ============ v70 PRODUCTION (2048 PPR turntable) ============"
puts "INFO: rtl files = [llength $src_rtl]"
puts "INFO: eth files = [llength $src_eth]"
puts "INFO: total     = [llength $src]"

foreach f $src { read_verilog $f }

read_xdc "$ROOT/constr/enc_top.xdc"
if {[file exists "$ROOT/constr/enc_top_eth.xdc"]} {
    read_xdc "$ROOT/constr/enc_top_eth.xdc"
}

synth_design -top enc_top -part xc7a35tfgg484-2 -flatten_hierarchy rebuilt

opt_design
place_design -directive ExtraTimingOpt
phys_opt_design -directive AggressiveExplore
route_design -directive Explore

report_utilization        -file "$OUTDIR/impl_util_v70.rpt"
report_timing_summary     -file "$OUTDIR/impl_timing_v70.rpt"
report_drc                -file "$OUTDIR/impl_drc_v70.rpt"
report_route_status       -file "$OUTDIR/impl_route_v70.rpt"
report_clock_interaction  -file "$OUTDIR/impl_clkint_v70.rpt"
report_io                 -file "$OUTDIR/impl_io_v70.rpt"
check_timing -verbose     -file "$OUTDIR/impl_check_timing_v70.rpt"
report_timing -delay_type max -max_paths 20 -sort_by group \
    -file "$OUTDIR/impl_top_paths_v70.rpt"
report_timing -delay_type min -max_paths 10 -sort_by group \
    -file "$OUTDIR/impl_hold_paths_v70.rpt"

write_bitstream -force "$OUTDIR/enc_top_v70b.bit"
puts "BITSTREAM_WRITTEN $OUTDIR/enc_top_v70b.bit"

puts "IMPL_CHECK_V69_DONE"
exit
