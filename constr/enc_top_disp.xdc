# =============================================================================
#  enc_top_disp.xdc  --  MERGED EXPERIMENT (encoder + 7-inch LCD display engine)
#  Device: xc7a35tfgg484-2   (ALIENTEK DaVinci Lite)
#
#  AUTO-GENERATED by tools/gen_merged_xdc.py (v2) -- do not edit by hand.
#  Sources: constr/enc_top.xdc + constr/enc_top_eth.xdc +
#           lcd_test2/constr/lcd_test2.xdc
#  To change a constraint, edit the source and re-run:
#      python tools/gen_merged_xdc.py
#
#  ONE rule governs this merge: no numeric value from either source is altered.
#  The experiment measures timing after putting two signed-off designs into one
#  device; quietly re-budgeting anything would make the number incomparable.
#
#  SCOPE: the encoder side is complete. The LCD side carries the pixel
#  interface (lcd_rgb / pclk / hs / vs / de / bl / rst) AND the capacitive
#  touch pins (touch_scl T4 / touch_sda U5 / touch_rst_n W4 / touch_int T5).
#  touch_int keeps PULLTYPE PULLUP -- without it the GT911 interrupt can
#  never be released high and no touch point is ever reported.
#  Still OUT of scope: panel-ID tri-state readback (lcd_rgb[7]/[15]/[23] as
#  inputs while lcd_rst is low). Do not read a healthy WNS here as
#  'the whole display subsystem fits'.
#
#  Port collisions: sys_clk / key_n / uart_tx exist in both sources; only the
#  enc_top.xdc copy is kept. Dropped lcd_test2 duplicates: sys_clk, key_n, uart_tx
#  Bank rails: J5/J6 VCCIO are selected by jumpers J9/J10 -- BOTH must be 3.3V.
# =============================================================================

# -----------------------------------------------------------------------------
# A. Encoder-side pins (verbatim from constr/enc_top.xdc)
#    ad_clk / ad_clk2 are the two ADC sample clocks and MUST be kept separate:
#    on the module CH1_CLK and CH2_CLK are independent nets.
# -----------------------------------------------------------------------------
set_property -dict {PACKAGE_PIN V4   IOSTANDARD LVCMOS33} [get_ports sys_clk]
set_property -dict {PACKAGE_PIN W9   IOSTANDARD LVCMOS33} [get_ports key_n]
set_property -dict {PACKAGE_PIN B18  IOSTANDARD LVCMOS33} [get_ports ad_clk]
set_property -dict {PACKAGE_PIN F16  IOSTANDARD LVCMOS33} [get_ports ad_clk2]
set_property -dict {PACKAGE_PIN F18  IOSTANDARD LVCMOS33} [get_ports {ad_ch1_d[0]}]
set_property -dict {PACKAGE_PIN E18  IOSTANDARD LVCMOS33} [get_ports {ad_ch1_d[1]}]
set_property -dict {PACKAGE_PIN C17  IOSTANDARD LVCMOS33} [get_ports {ad_ch1_d[2]}]
set_property -dict {PACKAGE_PIN D17  IOSTANDARD LVCMOS33} [get_ports {ad_ch1_d[3]}]
set_property -dict {PACKAGE_PIN A18  IOSTANDARD LVCMOS33} [get_ports {ad_ch1_d[4]}]
set_property -dict {PACKAGE_PIN A19  IOSTANDARD LVCMOS33} [get_ports {ad_ch1_d[5]}]
set_property -dict {PACKAGE_PIN C18  IOSTANDARD LVCMOS33} [get_ports {ad_ch1_d[6]}]
set_property -dict {PACKAGE_PIN C19  IOSTANDARD LVCMOS33} [get_ports {ad_ch1_d[7]}]
set_property -dict {PACKAGE_PIN F20  IOSTANDARD LVCMOS33} [get_ports {ad_ch1_d[8]}]
set_property -dict {PACKAGE_PIN F19  IOSTANDARD LVCMOS33} [get_ports {ad_ch1_d[9]}]
set_property -dict {PACKAGE_PIN B20  IOSTANDARD LVCMOS33} [get_ports {ad_ch1_d[10]}]
set_property -dict {PACKAGE_PIN A20  IOSTANDARD LVCMOS33} [get_ports {ad_ch1_d[11]}]
set_property -dict {PACKAGE_PIN E17  IOSTANDARD LVCMOS33} [get_ports {ad_ch2_d[0]}]
set_property -dict {PACKAGE_PIN C13  IOSTANDARD LVCMOS33} [get_ports {ad_ch2_d[1]}]
set_property -dict {PACKAGE_PIN B13  IOSTANDARD LVCMOS33} [get_ports {ad_ch2_d[2]}]
