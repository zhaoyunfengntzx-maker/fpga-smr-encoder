# -----------------------------------------------------------------------------
# A2. Ethernet-side pins (verbatim from constr/enc_top_eth.xdc)
#     RGMII: 4-bit TX/RX DDR at 125 MHz. eth_rxc is the PHY-supplied RX clock
#     and the reference for the RX input-delay budget; eth_txc is forwarded
#     by an ODDR inside u_enc/u_eth/u_rgmii (see the timing section).
#     v59 built these pins nowhere (the merged top had no eth ports at all),
#     so a working link could not exist no matter how the PHY straps were set.
# -----------------------------------------------------------------------------
set_property -dict {PACKAGE_PIN V18  IOSTANDARD LVCMOS33} [get_ports phy_rst_n]
set_property -dict {PACKAGE_PIN R14  IOSTANDARD LVCMOS33} [get_ports {eth_txd[0]}]
set_property -dict {PACKAGE_PIN P14  IOSTANDARD LVCMOS33} [get_ports {eth_txd[1]}]
set_property -dict {PACKAGE_PIN U18  IOSTANDARD LVCMOS33} [get_ports {eth_txd[2]}]
set_property -dict {PACKAGE_PIN U17  IOSTANDARD LVCMOS33} [get_ports {eth_txd[3]}]
set_property -dict {PACKAGE_PIN AA18 IOSTANDARD LVCMOS33} [get_ports eth_txc]
set_property -dict {PACKAGE_PIN AB18 IOSTANDARD LVCMOS33} [get_ports eth_tx_ctl]
set_property -dict {PACKAGE_PIN W17  IOSTANDARD LVCMOS33} [get_ports {eth_rxd[0]}]
set_property -dict {PACKAGE_PIN V17  IOSTANDARD LVCMOS33} [get_ports {eth_rxd[1]}]
set_property -dict {PACKAGE_PIN AB20 IOSTANDARD LVCMOS33} [get_ports {eth_rxd[2]}]
set_property -dict {PACKAGE_PIN AA19 IOSTANDARD LVCMOS33} [get_ports {eth_rxd[3]}]
set_property -dict {PACKAGE_PIN Y18  IOSTANDARD LVCMOS33} [get_ports eth_rxc]
set_property -dict {PACKAGE_PIN V19  IOSTANDARD LVCMOS33} [get_ports eth_rx_ctl]

# -----------------------------------------------------------------------------
# B. LCD-side pins (from lcd_test2/constr/lcd_test2.xdc, minus sys_clk, key_n, uart_tx)
#    The tri-state screen-ID read (lcd_rgb[7]/[15]/[23] driven as inputs while
#    lcd_rst is low) needs an IOBUF per data line and is NOT wired up in this
#    experiment: disp_engine drives all 24 lines as pure outputs. The pins and
#    the output-delay budget are still the signed-off ones, so the pixel-path
#    timing measured here is the right thing to compare against the encoder.
# -----------------------------------------------------------------------------
set_property -dict {PACKAGE_PIN V5   IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {lcd_rgb[0]}]
set_property -dict {PACKAGE_PIN AB1  IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {lcd_rgb[1]}]
set_property -dict {PACKAGE_PIN AA4  IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {lcd_rgb[2]}]
set_property -dict {PACKAGE_PIN AA1  IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {lcd_rgb[3]}]
set_property -dict {PACKAGE_PIN Y3   IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {lcd_rgb[4]}]
set_property -dict {PACKAGE_PIN Y1   IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {lcd_rgb[5]}]
set_property -dict {PACKAGE_PIN Y4   IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {lcd_rgb[6]}]
set_property -dict {PACKAGE_PIN W1   IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {lcd_rgb[7]}]
set_property -dict {PACKAGE_PIN W7   IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {lcd_rgb[8]}]
set_property -dict {PACKAGE_PIN Y7   IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {lcd_rgb[9]}]
set_property -dict {PACKAGE_PIN V7   IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {lcd_rgb[10]}]
set_property -dict {PACKAGE_PIN AB5  IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {lcd_rgb[11]}]
set_property -dict {PACKAGE_PIN Y6   IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {lcd_rgb[12]}]
set_property -dict {PACKAGE_PIN AB3  IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {lcd_rgb[13]}]
set_property -dict {PACKAGE_PIN AA3  IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {lcd_rgb[14]}]
set_property -dict {PACKAGE_PIN U6   IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {lcd_rgb[15]}]
set_property -dict {PACKAGE_PIN V9   IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {lcd_rgb[16]}]
set_property -dict {PACKAGE_PIN AB8  IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {lcd_rgb[17]}]
set_property -dict {PACKAGE_PIN V8   IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {lcd_rgb[18]}]
set_property -dict {PACKAGE_PIN AB7  IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {lcd_rgb[19]}]
set_property -dict {PACKAGE_PIN AA8  IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {lcd_rgb[20]}]
set_property -dict {PACKAGE_PIN AB6  IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {lcd_rgb[21]}]
set_property -dict {PACKAGE_PIN Y8   IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {lcd_rgb[22]}]
set_property -dict {PACKAGE_PIN AA6  IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports {lcd_rgb[23]}]
set_property -dict {PACKAGE_PIN U1   IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports lcd_pclk]
set_property -dict {PACKAGE_PIN AB2  IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports lcd_hs]
set_property -dict {PACKAGE_PIN T1   IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports lcd_vs]
set_property -dict {PACKAGE_PIN W2   IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports lcd_de]
set_property -dict {PACKAGE_PIN Y2   IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports lcd_bl]
set_property -dict {PACKAGE_PIN R2   IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports lcd_rst]
set_property -dict {PACKAGE_PIN T4   IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports touch_scl]
set_property -dict {PACKAGE_PIN U5   IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports touch_sda]
set_property -dict {PACKAGE_PIN W4   IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8} [get_ports touch_rst_n]
set_property -dict {PACKAGE_PIN T5   IOSTANDARD LVCMOS33 SLEW SLOW DRIVE 8 PULLTYPE PULLUP} [get_ports touch_int]

# -----------------------------------------------------------------------------
# C. Experiment probe: 8 free J5 pins (bank 15, not used by any on-board device)
# -----------------------------------------------------------------------------
#    Acceptance: disp_test[7:0] must increment once per frame (58.6 times/s).
#    Frozen counter => the timing generator or the renderer has stalled.
set_property -dict {PACKAGE_PIN M15  IOSTANDARD LVCMOS33} [get_ports {disp_test[0]}]
set_property -dict {PACKAGE_PIN M16  IOSTANDARD LVCMOS33} [get_ports {disp_test[1]}]
set_property -dict {PACKAGE_PIN L13  IOSTANDARD LVCMOS33} [get_ports {disp_test[2]}]
set_property -dict {PACKAGE_PIN M13  IOSTANDARD LVCMOS33} [get_ports {disp_test[3]}]
set_property -dict {PACKAGE_PIN K13  IOSTANDARD LVCMOS33} [get_ports {disp_test[4]}]
set_property -dict {PACKAGE_PIN K14  IOSTANDARD LVCMOS33} [get_ports {disp_test[5]}]
set_property -dict {PACKAGE_PIN J19  IOSTANDARD LVCMOS33} [get_ports {disp_test[6]}]
set_property -dict {PACKAGE_PIN H19  IOSTANDARD LVCMOS33} [get_ports {disp_test[7]}]

# -----------------------------------------------------------------------------
# D. Timing / configuration (union of all three sources, de-duplicated)
#    CFGBVS / CONFIG_VOLTAGE / COMPRESS appear in more than one source;
#    exactly one copy of each survives below. create_clock appears twice
#    by design: sys_clk (encoder) and eth_rxc_clk (PHY-supplied RX clock).
# -----------------------------------------------------------------------------
create_clock -period 20.000 -name sys_clk -waveform {0.000 10.000} [get_ports sys_clk]
set_property CFGBVS VCCO        [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]
set_false_path -from [get_ports key_n]
set_property PULLTYPE PULLDOWN [get_ports {ad_ch1_otr ad_ch2_otr}]
create_generated_clock -name adc_clk -source [get_pins u_enc/u_ad_clk_oddr/C] \
    -divide_by 1 [get_ports ad_clk]
create_generated_clock -name adc_clk2 -source [get_pins u_enc/u_ad_clk2_oddr/C] \
    -divide_by 1 [get_ports ad_clk2]
set_output_delay -clock adc_clk  -max 3.000 [get_ports ad_clk]
set_output_delay -clock adc_clk  -min 1.000 [get_ports ad_clk]
set_output_delay -clock adc_clk2 -max 3.000 [get_ports ad_clk2]
set_output_delay -clock adc_clk2 -min 1.000 [get_ports ad_clk2]
set_input_delay -clock sys_clk -max 14.000 [get_ports {ad_ch1_d[*] ad_ch2_d[*]}]
set_input_delay -clock sys_clk -min 9.500 [get_ports {ad_ch1_d[*] ad_ch2_d[*]}]
set_input_delay -clock sys_clk -max 14.000 [get_ports {ad_ch1_otr ad_ch2_otr}]
set_input_delay -clock sys_clk -min 9.500 [get_ports {ad_ch1_otr ad_ch2_otr}]
set_false_path -from [get_ports {spi_sck spi_ss_n spi_mosi uart_rx}]
set_output_delay -clock sys_clk -max 6.000 [get_ports {a_out b_out z_out u_out v_out w_out}]
set_output_delay -clock sys_clk -min 0.500 [get_ports {a_out b_out z_out u_out v_out w_out}]
set_output_delay -clock sys_clk -max 6.000 [get_ports {spi_miso}]
set_output_delay -clock sys_clk -min 0.500 [get_ports {spi_miso}]
set_output_delay -clock sys_clk -max 3.000 [get_ports {led[*]}]
set_output_delay -clock sys_clk -min 0.500 [get_ports {led[*]}]
set_output_delay -clock sys_clk -max 3.000 [get_ports {uart_tx irq_n}]
set_output_delay -clock sys_clk -min 0.500 [get_ports {uart_tx irq_n}]
set_property SLEW FAST [get_ports {a_out b_out z_out u_out v_out w_out spi_miso}]
set_property DRIVE 8   [get_ports {a_out b_out z_out u_out v_out w_out spi_miso}]
set_property SLEW SLOW [get_ports {led[*] uart_tx irq_n}]
set_property DRIVE 4   [get_ports {led[*] uart_tx irq_n}]
set_property SLEW FAST [get_ports {eth_txd[*] eth_txc eth_tx_ctl}]
set_property DRIVE 8   [get_ports {eth_txd[*] eth_txc eth_tx_ctl}]
set_property SLEW SLOW [get_ports phy_rst_n]
set_property DRIVE 4   [get_ports phy_rst_n]
create_clock -name eth_rxc_clk -period 8.000 [get_ports eth_rxc]
create_generated_clock -name eth_txc_out \
    -source [get_pins u_enc/u_eth/u_rgmii/u_oddr_clk/C] \
    -divide_by 1 \
    [get_ports eth_txc]
set_input_delay -clock eth_rxc_clk -max 2.300 [get_ports {eth_rxd[*] eth_rx_ctl}]
set_input_delay -clock eth_rxc_clk -min 1.700 [get_ports {eth_rxd[*] eth_rx_ctl}]
set_output_delay -clock eth_txc_out -max 1.500 [get_ports {eth_txd[*] eth_tx_ctl}]
set_output_delay -clock eth_txc_out -min 0.500 [get_ports {eth_txd[*] eth_tx_ctl}]
set_clock_groups -asynchronous \
    -group [get_clocks eth_rxc_clk] \
    -group [get_clocks -include_generated_clocks sys_clk]
set_max_delay -datapath_only 3.000 -from [get_clocks sys_clk] -to [get_clocks -filter {NAME =~ *clk_125*}]
set_max_delay -datapath_only 3.000 -from [get_clocks -filter {NAME =~ *clk_125*}] -to [get_clocks sys_clk]
set_false_path -from [get_clocks sys_clk] -to [get_ports phy_rst_n]
set_output_delay -clock sys_clk -max  5.000 [get_ports {lcd_rgb[*]}]
set_output_delay -clock sys_clk -min -1.000 [get_ports {lcd_rgb[*]}]
set_output_delay -clock sys_clk -max  5.000 [get_ports {lcd_hs lcd_vs lcd_de lcd_bl lcd_rst}]
set_output_delay -clock sys_clk -min -1.000 [get_ports {lcd_hs lcd_vs lcd_de lcd_bl lcd_rst}]
set_input_delay -clock sys_clk -max 10.000 [get_ports touch_int]
set_input_delay -clock sys_clk -min  0.000 [get_ports touch_int]
set_output_delay -clock sys_clk -max  5.000 [get_ports touch_int]
set_output_delay -clock sys_clk -min -1.000 [get_ports touch_int]
set_false_path -from [get_ports touch_int]
set_false_path -to   [get_ports touch_int]
set_false_path -from [get_ports {key_n touch_sda}]
set_false_path -to   [get_ports {touch_scl touch_sda touch_rst_n lcd_rst}]

# -----------------------------------------------------------------------------
# E. Probe output budget (indicator class: sampled by the far end, 17 ns is fine)
#    Same rationale as the LED/IRQ section of enc_top.xdc: the probe is a FRAME
#    COUNTER, not position information, so the exact edge instant carries no
#    meaning and a generous output delay is the honest constraint.
# -----------------------------------------------------------------------------
set_output_delay -clock sys_clk -max 3.000 [get_ports {disp_test[*]}]
set_output_delay -clock sys_clk -min 0.500 [get_ports {disp_test[*]}]
set_property SLEW SLOW [get_ports {disp_test[*]}]
set_property DRIVE 4   [get_ports {disp_test[*]}]

# -----------------------------------------------------------------------------
# F. Page-switch button (input): on-board USER KEY1 + 1 free J5 pin, active low
# -----------------------------------------------------------------------------
#    Acceptance: pressing it flips the page (P1 <-> P6 <-> P8).
#    key1_n is the ON-BOARD USER KEY1 (Y9) -- the one the operator can press
#    without a jumper wire. ui_btn (J5-29) is kept in parallel for an external
#    signal; the RTL ANDs the two (both are 'press to GND', both pulled up).
#    NOTE: key_n (W9 = USER KEY0) is the global ASYNC RESET in this design,
#    NOT a page button -- pressing it just re-initialises the whole design.
#    Pull-up is mandatory: the button only shorts the pin to GND, so without it
#    the level floats and the debounce counter sees random edges.
#    No input delay: the edge instant carries no meaning after the 20 ms
#    debounce, exactly like key_n in enc_top.xdc.
set_property -dict {PACKAGE_PIN Y9   IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {key1_n}]
set_property -dict {PACKAGE_PIN H14  IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {ui_btn}]
set_false_path -from [get_ports {key1_n ui_btn}]

